# ----------------------------------------------------------------------------------
# Stage 1: Build
# ----------------------------------------------------------------------------------

FROM golang:1.24.5-alpine AS builder
WORKDIR /app

# ----------------------------------------------------------------------------------
# Build arguments
# ----------------------------------------------------------------------------------

ARG GITHUB_TOKEN
ARG INSTANCE_PORT

# ----------------------------------------------------------------------------------
# Install prerequisites
# ----------------------------------------------------------------------------------

RUN apk add --no-cache git ca-certificates openssh && \
    echo "🔧 Installing build dependencies..." && \
    apk add --no-cache build-base libwebp-dev

# ----------------------------------------------------------------------------------
# Auth for private repos (disable proxies)
# ----------------------------------------------------------------------------------

ENV GOPRIVATE=github.com/complyage,github.com/ralphferrara
ENV GONOSUMDB=github.com/complyage,github.com/ralphferrara
ENV GOSUMDB=off
ENV GOPROXY=https://proxy.golang.org,direct

RUN git config --global url."https://${GITHUB_TOKEN}:x-oauth-basic@github.com/".insteadOf "https://github.com/"

# ----------------------------------------------------------------------------------
# Copy module files safely
# ----------------------------------------------------------------------------------

COPY go.mod go.sum ./
RUN [ -f go.mod ] || go mod init instance

# Clean out any local replacements
RUN sed -i '/replace/d' go.mod || true && sed -i '/=> ../d' go.mod || true

# ----------------------------------------------------------------------------------
# Clone private modules directly (always succeeds)
# ----------------------------------------------------------------------------------

RUN mkdir -p /root/go/src/github.com/complyage /root/go/src/github.com/ralphferrara && \
    git clone --depth=1 https://${GITHUB_TOKEN}:x-oauth-basic@github.com/complyage/base.git /root/go/src/github.com/complyage/base && \
    git clone --depth=1 https://${GITHUB_TOKEN}:x-oauth-basic@github.com/ralphferrara/aria.git /root/go/src/github.com/ralphferrara/aria

# ----------------------------------------------------------------------------------
# Force replace to local modules *before* resolving deps
# ----------------------------------------------------------------------------------

RUN go mod edit -replace=github.com/complyage/base=/root/go/src/github.com/complyage/base && \
    go mod edit -replace=github.com/ralphferrara/aria=/root/go/src/github.com/ralphferrara/aria && \
    go mod edit -require=github.com/complyage/base@v0.0.0 && \
    go mod edit -require=github.com/ralphferrara/aria@v0.0.0

# ----------------------------------------------------------------------------------
# Copy the rest of the instance code
# ----------------------------------------------------------------------------------

COPY . .

# ----------------------------------------------------------------------------------
# Final tidy and build
# ----------------------------------------------------------------------------------

RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    go env -w GOPROXY=https://proxy.golang.org,direct && \
    go mod tidy && go mod download all && \
    echo "⚙️ Building instance binary..." && \
    CGO_ENABLED=1 GOOS=linux GOARCH=amd64 go build -o instance . && \
    test -f /app/instance || (echo "❌ Build failed — missing /app/instance" && exit 1)

# ----------------------------------------------------------------------------------
# Stage 2: Runtime
# ----------------------------------------------------------------------------------

FROM alpine:latest

# ✅ Work from /app/instance so ../config.json resolves correctly
WORKDIR /app/instance

ARG INSTANCE_PORT
ENV INSTANCE_PORT=${INSTANCE_PORT}

# Copy compiled binary
COPY --from=builder /app/instance /app/instance/instance
RUN chmod +x /app/instance/instance

# Copy config + env into parent (/app)
COPY .env /app/.env
COPY config.json /app/config.json
COPY .secure /app/.secure

# Verify layout
RUN echo "---- Verifying structure ----" && ls -la /app && ls -la /app/instance || true

EXPOSE ${INSTANCE_PORT}

# Run instance normally (auto stays up if crash)
CMD sh -c "./instance || (echo '\n⚠️ Instance exited — keeping container alive for debugging...' && tail -f /dev/null)"
