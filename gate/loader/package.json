{
      "name"             : "complyage",
      "version"          : "1.0.0",
      "description"      : "ComplyAge JS package",
      "type"             : "module",
      "scripts"          : {
            "dev"        : "concurrently \"esbuild ./index.js --bundle --outfile=dist/complyage.js --format=esm --sourcemap --watch\" \"serve dist -l 54743 --single --no-clipboard\"",
            "build"      : "esbuild ./index.js --bundle --minify --outfile=dist/complyage.min.js --format=esm"
      },
      "devDependencies"  : {
            "esbuild"    : "^0.24.0",
            "serve"      : "^14.2.3",
            "concurrently": "^9.0.0"
      }
}
